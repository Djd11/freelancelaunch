    And Day 33 should be "Pricing Strategy for New Upwork Freelancers"         # tests/steps/test_platform_curriculum.py:222
    And Day 37 should be "Building Job Success Score & Getting Repeat Clients" # tests/steps/test_platform_curriculum.py:222
