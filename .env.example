# FreelanceLaunch — Environment Variables
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=development
PORT=5000

# Supabase (https://supabase.com dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# LLM API (for curriculum generation)
# Use your Hermes provider (OpenCode.ai big-pickle) or any OpenAI-compatible API.
# Leave LLM_API_KEY empty to use ~/.hermes/config.yaml (big-pickle via OpenCode.ai).
LLM_API_URL=http://localhost:3002/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=big-pickle

# Stripe (for paid tiers — https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GUIDED_PRICE_ID=price_...
STRIPE_PLACEMENT_PRICE_ID=price_...

# Gumroad (fallback payments — https://app.gumroad.com/settings/advanced)
GUMROAD_TOKEN=
GUMROAD_GUIDED_URL=https://gumroad.com/l/...
GUMROAD_PLACEMENT_URL=https://gumroad.com/l/...

# YouTube Data API (https://console.cloud.google.com → APIs & Services)
YOUTUBE_API_KEY=your-youtube-api-key

# Render hosting (your deployed URL)
RENDER_EXTERNAL_URL=http://localhost:5000

# Admin access
ADMIN_EMAIL=your@email.com
