# ── Sprint Platform · environment template ──────────────────────────────
# ⚠️  These values MUST point to the NEW, dedicated Supabase project for
#     the sprint platform. Never reuse the v1 project credentials —
#     the schemas collide (see db/schema.sql guard + docs/supabase-setup.md).

# New Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://<sprint-platform-project>.supabase.co

# New project anon key (Project Settings → API → anon public)
SUPABASE_ANON_KEY=<your-new-anon-key>

# New project service-role key (server-side only; never ship to the client)
SUPABASE_SERVICE_ROLE_KEY=<your-new-service-role-key>

# Flask
SECRET_KEY=<generate-a-long-random-string>
FLASK_ENV=development

# LLM fallback chain (optional — app works without these)
OPENROUTER_API_KEY=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Admin (for /admin feed curation + cohort creation)
ADMIN_EMAIL=
