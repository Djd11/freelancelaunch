# ── Sprint Platform · environment template ──────────────────────────────
# ⚠️  These values MUST point to the NEW, dedicated Supabase project for
#     the sprint platform. Never reuse the v1 project credentials —
#     the schemas collide (see db/schema.sql guard + docs/supabase-setup.md).

# New Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://<sprint-platform-project>.supabase.co

# New project anon key (Project Settings → API → anon public)
SUPABASE_ANON_KEY=<your-new-anon-key>

# New project service-role key (server-side only; never ship to the client)
SUPABASE_SERVICE_ROLE_KEY=<your-new-service-role-key>

# Flask
SECRET_KEY=<generate-a-long-random-string>
FLASK_ENV=development

# LLM fallback chain (optional — app works without these)
# LLM_API_URL accepts the FULL chat-completions endpoint (…/v1/chat/completions)
# OR the provider base (…/v1 or bare origin) — services/llm.py normalizes it.
# LLM_MODEL must be a model the endpoint actually serves (e.g. "auto/best-chat"
# for a local omniroute; "gpt-4o-mini" only works where that model is funded).
OPENROUTER_API_KEY=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Admin (for /admin feed curation + cohort creation)
ADMIN_EMAIL=
# Canonical public origin. REQUIRED whenever FLASK_ENV=production: the app
# refuses to boot without it, because it is both the OAuth redirect_to base
# and the origin that must be listed in Supabase → Auth → URL Configuration.
# Local/dev runs may leave it unset (falls back to http://localhost:5000).
PUBLIC_BASE_URL=http://localhost:5000

# ── Passwordless auth (email OTP + social) — all OPTIONAL ─────────────
# These only toggle app behaviour. Provider credentials, the OTP email
# TEMPLATE ({{ .Token }}) and SMTP itself are configured in the Supabase
# dashboard — see docs/supabase-setup.md. No new secrets live here.
#
# Comma list of social buttons to render + accept at /auth/oauth/<provider>.
# Known names: google, facebook, x, twitter (anything else is dropped, not
# rendered). "x" is the dashboard's current X provider (OAuth 2.0); "twitter"
# is the DEPRECATED OAuth 1.0a card — they are separate GoTrue providers, so
# this value must match whichever card is enabled in the Supabase dashboard.
# Facebook needs Meta app review before production: leave this at "google,x"
# on Render until then, and append ",facebook" later — no redeploy needed.
OAUTH_PROVIDERS=google,x
# Set false to hide the code form and fall back to password-only sign-in.
OTP_EMAIL_ENABLED=true
# Server-side resend throttle in seconds (default 60).
# OTP_RESEND_COOLDOWN_SECONDS=60
# Must match dashboard → Authentication → One-time tokens → OTP length.
# This project uses 8 (measured 2026-09-15).
# OTP_CODE_LENGTH=8

